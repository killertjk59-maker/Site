# ===== OSHONA — намунаи танзимот =====
# Нусхабардорӣ: cp .env.example .env   (ҳаргиз .env-ро ба GitHub напайвандед)
# Дар Railway ин қиматҳоро дар Variables гузоред (PORT-ро нагузоред — Railway худаш медиҳад).

# ---- Асосӣ ----
# NODE_ENV=production        # дар production; ё RAILWAY_* муҳит худаш production-ро фаъол мекунад
DATA_DIR=./data
CURRENCY=TJS

# ---- Админ (ҳатмист дар production) ----
# JWT_SECRET: камаш 32 аломати тасодуфӣ.
# Сохтан: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
# ADMIN_PASSWORD: камаш 10 аломат; admin123 рад мешавад.
ADMIN_PASSWORD=
# ё ADMIN_PASSWORD_HASH=<bcrypt-hash>   (ба ҷои ADMIN_PASSWORD)

# ---- Пардохт (ҳамён) ----
DUSHANBE_CITY_WALLET=034392828
DUSHANBE_CITY_NAME=OSHONA
ALIF_WALLET=034392828
ALIF_NAME=OSHONA
# Ихтиёрӣ: мерчант-линкҳо бо {wallet}, {amount}, {code}
DC_PAY_URL=
ALIF_PAY_URL=

# ---- Амният ----
# Origin-ҳои иҷозатдодашуда (вергул бо ҷудо). Холӣ = CORS барои берун баста.
CORS_ORIGINS=
# Дар Railway: 1 (reverse proxy). Дар компютер: false.
TRUST_PROXY=
# Зарбкунаки маҳдудияти дархостҳо (1 = пешфарз). Танҳо бо эҳтиёҷ тағйир диҳед.
RATE_LIMIT_SCALE=1

# ---- OSHONA AI (OpenRouter) ----
# Калид танҳо дар муҳити сервер. Ҳаргиз дар код ё GitHub нагузоред.
OPENROUTER_API_KEY=
# Ихтиёрӣ: иваз кардани моделҳо (пешфарз — config/ai.json)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
AI_DAILY_LIMIT=500
AI_TIMEOUT_MS=20000

# ---- Telegram-бот ----
TELEGRAM_BOT_TOKEN=
# Бе @
TELEGRAM_BOT_USERNAME=
# 16+ аломат, ҳарфу рақам (барои webhook)
TELEGRAM_WEBHOOK_SECRET=
# ID-ҳои рақамии Telegram (на username), вергул бо ҷудо
TELEGRAM_ADMIN_IDS=
