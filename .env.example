# ===== OSHONA Backend — танзимот =====
PORT=3000

# Калиди махфӣ барои токен (иваз кунед!)
JWT_SECRET=oshona_super_secret_2026_change_me

# Админ (логин / парол)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== Пардохт (Алиф / Душанбе Сити) =====
# Рақами ҳамёни шумо — пул ба ҳамин меравад:
DUSHANBE_CITY_WALLET=034392828
DUSHANBE_CITY_NAME=OSHONA
ALIF_WALLET=034392828
ALIF_NAME=OSHONA

# Линкҳои автоматии пардохт (ихтиёрӣ — танҳо бо шартномаи merchant).
# {wallet} {amount} {code} автомати пур мешаванд. Агар холӣ — тугмаҳо
# ҳамён+суммаро нусха мекунанд ва дастур медиҳанд.
# DC_PAY_URL=https://.../{wallet}/{amount}/{code}
# ALIF_PAY_URL=https://.../{wallet}/{amount}/{code}

CURRENCY=TJS
