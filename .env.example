# ===== OSHONA Backend — танзимот =====
PORT=3000

# Калиди махфӣ барои токен (иваз кунед!)
JWT_SECRET=oshona_super_secret_2026_change_me

# Админ (логин / парол)
ADMIN_USERNAME=admin
# Парол бо bcrypt ҳеш карда шудааст (пешфарз: admin123)
# Агар хоҳед паролро иваз кунед — матни оддиро ба ADMIN_PASSWORD нависед,
# сервер худаш ҳеш мекунад. Ё ҳеши тайёрро ба ADMIN_PASSWORD_HASH гузоред.
ADMIN_PASSWORD=admin123

# ===== Пардохт (дастӣ — Душанбе Сити / Алиф) =====
# Рақамҳои ҳамёни шумо:
DUSHANBE_CITY_CARD=4444 5555 6666 7777
DUSHANBE_CITY_NAME=OSHONA
ALIF_CARD=5555 6666 7777 8888
ALIF_NAME=OSHONA

CURRENCY=TJS
